    },
    {
      "name": "score_svudg",
      "description": "S vs. UDG (ud/g reweighted, x = 1.000): (ak4_probs) / ((ak4_probs) + (2 * (ak4_probud) + 0 * (ak4_probg)) + 1e-10), clamped into the axis range [0.0, 1.0] as for the WPs",
      "version": 1,
