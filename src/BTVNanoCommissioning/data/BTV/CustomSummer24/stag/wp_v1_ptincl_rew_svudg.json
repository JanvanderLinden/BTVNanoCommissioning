        "variables": [
          "btagNoPIDParTAK4probb",
          "btagNoPIDParTAK4probbb",
          "btagNoPIDParTAK4probc",
          "btagNoPIDParTAK4probcc",
          "btagNoPIDParTAK4probg",
          "btagNoPIDParTAK4probs",
          "btagNoPIDParTAK4probud"
        ]
      }
    },
    {
      "name": "score_cvnotb",
      "description": "C vs. not-B: ak4_cvnotb, clamped into the axis range [0.0, 1.0] as for the WPs",
      "version": 1,
      "inputs": [
        {
          "name": "btagNoPIDParTAK4probb",
          "type": "real",
          "description": "Jet_btagNoPIDParTAK4probb (NanoAOD)"
        },
        {
          "name": "btagNoPIDParTAK4probbb",
          "type": "real",
          "description": "Jet_btagNoPIDParTAK4probbb (NanoAOD)"
        },
        {
          "name": "btagNoPIDParTAK4probc",
          "type": "real",
          "description": "Jet_btagNoPIDParTAK4probc (NanoAOD)"
        },
        {
          "name": "btagNoPIDParTAK4probcc",
          "type": "real",
          "description": "Jet_btagNoPIDParTAK4probcc (NanoAOD)"
        },
        {
          "name": "btagNoPIDParTAK4probg",
          "type": "real",
          "description": "Jet_btagNoPIDParTAK4probg (NanoAOD)"
        },
        {
          "name": "btagNoPIDParTAK4probs",
          "type": "real",
          "description": "Jet_btagNoPIDParTAK4probs (NanoAOD)"
        },
